# EmailJS — delivers the contact-form enquiry to vansh@nelsuntea.in
# Create these at https://dashboard.emailjs.com (see the README for the walkthrough).
#
# Copy this file to .env.local for local development, and add the same three
# variables in Vercel under Project Settings -> Environment Variables.
#
# These are NEXT_PUBLIC_ on purpose: EmailJS is designed to be called from the
# browser and the public key is not a secret. Lock the account down in the
# EmailJS dashboard instead (allowed domains + reCAPTCHA) — see README.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxx

# Optional: where enquiries are sent (defaults to vansh@nelsuntea.in)
NEXT_PUBLIC_ENQUIRY_RECIPIENT=vansh@nelsuntea.in
